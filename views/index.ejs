<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Webshop
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Termékek</h1>

    <form method="POST">
        <div>
            <div class="termek-kartya">
                <h3>Kingston FURY 16GB DDR5 6000MT/s CL30 Beast Black EXPO</h3>
                <p>124 990 Ft</p>
                <img class="termek-kep" src="./1.webp">
                <input type="radio" name="termek" value="ram"
                    <%= locals.elozo.termek === 'ram' ? 'checked' : '' %>
                >
            </div>
            <div class="termek-kartya">
                <h3>Porszívó</h3>
                <p>20 000 Ft</p>
                <img class="termek-kep" src="./2.webp">
                <input type="radio" name="termek" value="porszivo"
                    <%= locals.elozo.termek === 'porszivo' ? 'checked' : '' %>
                >
            </div>
            <div class="termek-kartya">
                <h3>Munkavédelmi cipő</h3>
                <p>10 000 Ft</p>
                <img class="termek-kep" src="./3.png">
                <input type="radio" name="termek" value="cipo"
                    <%= locals.elozo.termek === 'cipo' ? 'checked' : '' %>
                >
            </div>
        </div>

        <label for="nev">Név:</label><br>
        <input type="text" name="nev" placeholder="Név" value="<%= locals.elozo.nev %>"><br>

        <label for="szamlazasi">Számlázási cím:</label><br>
        <input type="text" name="szamlazasi" value="<%= locals.elozo.szamlazasi %>" placeholder="Város, Irányítószám, Utca és házszám"><br>

        <label for="szallitasi">Szállítási cím:</label><br>
        <input type="text" name="szallitasi" value="<%= locals.elozo.szallitasi %>" placeholder="Város, Irányítószám, Utca és házszám"><br>

        <label for="telefonszam">Telefonszám:</label><br>
        <input type="text" name="telefonszam" value="<%= locals.elozo.telefonszam %>" placeholder="+36 XX XXX XXXX"><br>

        <label for="kupon">Kuponkód:</label><br>
        <input type="text" name="kupon" placeholder="BB-SSSS" value="<%= locals.elozo.kupon %>"><br>



        <label for="bankkartya">Bankkártya szám:</label><br>
        <input type="text" name="bankkartya" value="<%= locals.elozo.bankkartya %>" placeholder="XXXX-XXXX-XXXX-XXXX"><br>

        <label for="lejarat">Lejárati dátum:</label><br>
        <input type="text" name="lejarat" placeholder="HH/ÉÉ" value="<%= locals.elozo.lejarat %>"><br>

        <label for="kod">Biztonsági kód:</label><br>
        <input type="text" name="kod" placeholder="XXX" value="<%= locals.elozo.kod %>"><br>

        <% if (locals.errors) { %>
            <% errors.forEach(error => { %>
                <p><%= error %></p>
            <% }) %>
        <% } %>

        <button type="submit">Vásárlás</button>
    </form>
</body>

</html>